# ─── Add these to your Laravel .env ──────────────────────────────────────────
# After deploying Sentry, log in → Settings → Projects → <project> → Client Keys (DSN)

SENTRY_LARAVEL_DSN=https://<key>@sentry.yourdomain.com/<project-id>
SENTRY_TRACES_SAMPLE_RATE=0.1        # 10% of transactions — adjust per traffic volume
SENTRY_PROFILES_SAMPLE_RATE=0.1      # 10% profiling (only on feature-complete profile)
SENTRY_SEND_DEFAULT_PII=false        # set true only if you need user context
