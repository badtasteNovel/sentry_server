# ── Ubuntu 登入密碼 (SSH) ──────────────────────────────────────────────────
# 用以下指令產生 hash，然後把輸出貼進來（含 $6$...）：
#   openssl passwd -6 'your-password'
# 注意：整個值要用單引號包住，避免 $ 被 bash 解析
UBUNTU_PASSWORD_HASH='$6$REPLACE_ME$REPLACE_WITH_OUTPUT_OF_openssl_passwd'

# ── Sentry 版本 ────────────────────────────────────────────────────────────
SENTRY_VERSION=26.4.2
COMPOSE_PROFILE=errors-only   # errors-only (16GB RAM) 或 feature-complete (32GB RAM)

# ── Domain & Admin ─────────────────────────────────────────────────────────
SENTRY_DOMAIN=sentry.yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── SMTP (選填，不用 email 通知就全留空) ───────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
