# ── 網路（靜態 IP） ────────────────────────────────────────────────────────
# IP 請含 CIDR，子網路遮罩 /24 = 255.255.255.0
STATIC_IP=192.168.0.242/24
GATEWAY=192.168.0.1
DNS=8.8.8.8,8.8.4.4
# SSH port（避免使用預設 22，降低被掃描風險）
SSH_PORT=2222

# ── SSH Public Key ─────────────────────────────────────────────────────────
# SSH key 放在 cert/ 資料夾，執行 task import-ssh-key 自動複製過去

# ── Ubuntu ISO（本機測試用，task test 會讀這個） ───────────────────────────
UBUNTU_ISO=ubuntu-24.04.4-live-server-amd64.iso

# ── Sentry 版本 ────────────────────────────────────────────────────────────
SENTRY_VERSION=26.4.2
COMPOSE_PROFILE=errors-only   # errors-only (16GB RAM) 或 feature-complete (32GB RAM)

# ── Domain & Admin ─────────────────────────────────────────────────────────
SENTRY_DOMAIN=sentry.yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── SMTP (選填，不用 email 通知就全留空) ───────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
